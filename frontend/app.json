{
  "expo": {
    "name": "SW Project",
    "slug": "sw-project-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.swproject.app",
      "userInterfaceStyle": "light"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "./plugins/withNoForceDark",
      "expo-image"
    ],
    "scheme": "swproject",
    "experiments": {
      "typedRoutes": false
    }
  }
}
