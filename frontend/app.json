{
  "expo": {
    "name": "SW Project",
    "slug": "sw-project-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.swproject.app",
      "userInterfaceStyle": "light"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "./plugins/withNoForceDark",
      "expo-image",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to take mission photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to pick photos from your gallery."
        }
      ]
    ],
    "scheme": "swproject",
    "experiments": {
      "typedRoutes": false
    }
  }
}
