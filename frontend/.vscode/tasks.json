{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: start emulator",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\Android\Sdk\emulator\emulator.exe\" -avd medium_phone",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Android: start emulator inside VS Code (Mobile Deck)",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd medium_phone -no-window",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Preview: Android emulator (Expo Go)",
      "type": "shell",
      "command": "npx expo start --android",
      "options": { "env": { "ANDROID_HOME": "${env:LOCALAPPDATA}\Android\Sdk" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Preview: phone (Expo Go QR code)",
      "type": "shell",
      "command": "npx expo start",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Preview: web (use with MobileView → localhost:8081)",
      "type": "shell",
      "command": "npx expo start --web",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
